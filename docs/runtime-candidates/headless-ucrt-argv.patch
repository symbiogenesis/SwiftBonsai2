+++ b/tests/test-headless-argv.cpp
@@ -0,0 +1,59 @@
+// Model-free Windows UCRT argv regression. No model or backend is initialized.
+// Invoke the named cases through the native worker supervisor to also retain
+// Win32k-denied startup and the application's command-line quoting boundary.
+#include "arg.h"
+#include "common.h"
+
+#include <windows.h>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    const std::vector<std::string> expected = {
+        "",
+        u8"日本語 🪴 café",
+        R"(C:\notes dir\ "quoted" tail\\)",
+        "line1\tline2\nline3",
+        "*.gguf",
+        "  leading and trailing  ",
+        R"(slashes\\\"quote)",
+    };
+    PROCESS_MITIGATION_SYSTEM_CALL_DISABLE_POLICY calls{};
+    PROCESS_MITIGATION_EXTENSION_POINT_DISABLE_POLICY extensions{};
+    PROCESS_MITIGATION_IMAGE_LOAD_POLICY images{};
+    if (!GetProcessMitigationPolicy(GetCurrentProcess(), ProcessSystemCallDisablePolicy, &calls, sizeof(calls)) ||
+        !GetProcessMitigationPolicy(GetCurrentProcess(), ProcessExtensionPointDisablePolicy, &extensions, sizeof(extensions)) ||
+        !GetProcessMitigationPolicy(GetCurrentProcess(), ProcessImageLoadPolicy, &images, sizeof(images)) ||
+        !calls.DisallowWin32kSystemCalls || !extensions.DisableExtensionPoints ||
+        !images.NoRemoteImages || !images.NoLowMandatoryLabelImages) return 5;
+    if (argc != 7) return 1;
+    wchar_t** retained_argv = nullptr;
+    for (int repeat = 0; repeat < 2; ++repeat) {
+        common_params params;
+        // Check argv bytes before the CLI's optional prompt escape processing.
+        params.escape = false;
+        if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMPLETION)) return 2;
+        if (params.model.path != u8"模型/test.gguf") return 7;
+        if (!__wargv) return 6;
+        if (repeat == 0) retained_argv = __wargv;
+        if (retained_argv != __wargv) return 6;
+        const auto index = params.sampling.seed;
+        if (index >= expected.size() || params.prompt != expected[index]) return 3;
+        // Preserve the existing repair guard for callers providing a synthetic
+        // argv whose count differs from the process's command line.
+        char name[] = "fixture";
+        char option[] = "--prompt";
+        char value[] = "custom";
+        char model_option[] = "--model";
+        char model_value[] = "synthetic.gguf";
+        char * custom[] = {name, model_option, model_value, option, value, nullptr};
+        common_params synthetic;
+        if (!common_params_parse(5, custom, synthetic, LLAMA_EXAMPLE_COMPLETION) ||
+            synthetic.prompt != "custom") return 4;
+        if (retained_argv != __wargv) return 6;
+    }
+    std::puts("Win32k=1 Extensions=1 Images=3; Unicode argv and synthetic argc guard passed");
+    return 0;
+}
